import { LengthEdit, ToolBarButton } from "../../widgets.slint";
import {
    PanelTabData,
    WindowSectionData,
} from "../../api.slint";

// A dedicated, trimmed-down toolbar rather than reusing board/
// addpadtoolbar.slint's fiducial mode.  A panel fiducial has the same two
// size dimensions a board fiducial pad does (copper diameter, solder-mask
// clearance/gap) and a board side (see PI_Fiducial's class doc), but none
// of the other pad-specific fields (net/shape/ratio/press-fit).
export component AddFiducialToolBar inherits HorizontalLayout {
    in property <int> section-index;
    in-out property <WindowSectionData> section;
    property <[PanelTabData]> tabs: section.panel-tabs;

    spacing: 2px;

    side-selector := ToolBarButton {
        property <bool> bottom: tabs[section.current-tab-index].tool-bottom;

        icon: {
            if bottom {
                @image-url("../../../../bootstrap-icons/icons/back.svg")
            } else {
                @image-url("../../../../bootstrap-icons/icons/front.svg")
            }
        };
        tooltip: @tr("Board Side");

        clicked => {
            tabs[section.current-tab-index].tool-bottom = !bottom;
        }
    }

    diameter-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-diameter;
        icon: @image-url("../../../../font-awesome/svgs/solid/arrows-left-right.svg");
        tooltip: @tr("Diameter");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-diameter.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-diameter.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-diameter.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-diameter.decrease = true;
        }
    }

    clearance-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-clearance;
        icon: @image-url("../../../../bootstrap-icons/icons/sign-stop.svg");
        tooltip: @tr("Solder Mask Clearance");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-clearance.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-clearance.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-clearance.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-clearance.decrease = true;
        }
    }
}
