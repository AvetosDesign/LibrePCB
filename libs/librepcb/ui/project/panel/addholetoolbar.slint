import { LengthEdit } from "../../widgets.slint";
import {
    PanelTabData,
    WindowSectionData,
} from "../../api.slint";

// Mirrors board/addholetoolbar.slint exactly, but bound to PanelTabData and
// reusing the same tool-diameter field addfiducialtoolbar.slint already
// uses (a panel hole and a panel fiducial share the one diameter control on
// PanelTab, mirroring how Board2dTab shares mToolDrill between its Via and
// Hole tools).
export component AddHoleToolBar inherits HorizontalLayout {
    in property <int> section-index;
    in-out property <WindowSectionData> section;
    property <[PanelTabData]> tabs: section.panel-tabs;

    spacing: 2px;

    diameter-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-diameter;
        icon: @image-url("../../../../font-awesome/svgs/solid/bore-hole.svg");
        tooltip: @tr("Diameter");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-diameter.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-diameter.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-diameter.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-diameter.decrease = true;
        }
    }
}
