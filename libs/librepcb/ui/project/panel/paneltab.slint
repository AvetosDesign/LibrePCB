// AI DISCLAIMER: Claude AI assisted in the writing of this file.
// It was reviewed by a human on 2026-09-17.

import { AddFiducialToolBar } from "addfiducialtoolbar.slint";
import { AddHoleToolBar } from "addholetoolbar.slint";
import { AddVCutToolBar } from "addvcuttoolbar.slint";
import { Tab } from "../../tab.slint";
import { SceneButton, TextInput, ToolBar, ToolButton } from "../../widgets.slint";
import {
    Backend,
    Data,
    EditorCommandSet as Cmd,
    EditorTool,
    PanelTabData,
    TabAction,
    WindowSectionData,
} from "../../api.slint";

// Panel editor tab: a pannable/zoomable canvas with a left-side tool column
// (Select / Add Hole / Add Fiducial / Add Tab / Add V-Cuts), following
// Board2dTab's toolbuttons-l pattern.
export component PanelTab inherits Tab {
    in property <int> section-index;
    in-out property <WindowSectionData> section;
    property <[PanelTabData]> tabs: section.panel-tabs;
    property <int> index: section.current-tab-index;
    property <length> toolbar-space: view-buttons-l.x - toolbuttons-l.x - toolbuttons-l.width - 10px;
    property <length> toolbutton-offset-y: (toolbar-r.width > toolbar-space) ? toolbar-r.height : 0;

    function update-tab-data() {
        tabs[index].scene-image-pos = self.absolute-position;
    }

    enabled: true;

    init => {
        update-tab-data();
    }

    // Needed for https://github.com/LibrePCB/LibrePCB/issues/1725.
    changed section-index => {
        update-tab-data();
    }

    // Needed for https://github.com/LibrePCB/LibrePCB/issues/1725.
    changed index => {
        update-tab-data();
    }

    changed absolute-position => {
        update-tab-data();
    }

    if Data.preview-mode: Rectangle {
        background: white;
    }

    img := Image {
        width: 100%;
        height: 100%;
        source: Backend.render-scene(section-index, root.width, root.height, 0, tabs[index].frame);
        accessible-role: none;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: tabs[index].tool-cursor;

        // Info box for the current selection - same as Board2dTab's
        // overlay. Shown only if the text is not empty.
        if !tabs[index].tool-overlay-text.is-empty: Rectangle {
            x: 2 * toolbuttons-l.x + toolbuttons-l.width;
            y: toolbuttons-l.y;
            width: min(self.preferred-width, 0.5 * parent.width);
            height: self.preferred-height;
            background: Data.theme.control;
            border-radius: 3px;
            border-width: 1px;
            border-color: Data.theme.control-border;
            clip: true;

            VerticalLayout {
                padding: 6px;

                overlay-txt := TextInput {
                    horizontal-alignment: left;
                    vertical-alignment: top;
                    font-family: "Noto Sans Mono";
                    color: Data.theme.control-text;
                    text: tabs[index].tool-overlay-text;
                    read-only: true;
                }
            }
        }

        toolbuttons-l := VerticalLayout {
            x: 7px;
            y: 7px + toolbutton-offset-y;
            width: self.preferred-width;
            height: parent.height - 2 * self.y;
            alignment: start;
            spacing: 5px;

            tool-select-btn := ToolButton {
                cmd: Cmd.tool-select;
                checked: tabs[index].tool == EditorTool.select;

                clicked => {
                    Backend.trigger-tab(section-index, index, TabAction.tool-select);
                }
            }

            tool-hole-btn := ToolButton {
                cmd: Cmd.tool-hole;
                checked: tabs[index].tool == EditorTool.hole;

                clicked => {
                    Backend.trigger-tab(section-index, index, TabAction.tool-hole);
                }
            }

            tool-fiducial-btn := ToolButton {
                cmd: Cmd.tool-fiducial;
                checked: tabs[index].tool == EditorTool.fiducial;

                clicked => {
                    Backend.trigger-tab(section-index, index, TabAction.tool-fiducial);
                }
            }

            tool-panel-tab-btn := ToolButton {
                cmd: Cmd.tool-panel-tab;
                checked: tabs[index].tool == EditorTool.panel-tab;

                clicked => {
                    Backend.trigger-tab(section-index, index, TabAction.tool-panel-tab);
                }
            }

            tool-panel-vcut-btn := ToolButton {
                cmd: Cmd.tool-panel-vcut;
                checked: tabs[index].tool == EditorTool.panel-vcut;

                clicked => {
                    Backend.trigger-tab(section-index, index, TabAction.tool-panel-vcut);
                }
            }
        }

        toolbar-r := ToolBar {
            y: -1px;
            width: min(self.preferred-width, root.width - 10px);
            visible: self.width > 30px;

            if tabs[index].tool == EditorTool.fiducial: fiducial-toolbar := AddFiducialToolBar {
                section-index: section-index;
                section: section;
            }

            if tabs[index].tool == EditorTool.hole: hole-toolbar := AddHoleToolBar {
                section-index: section-index;
                section: section;
            }

            if tabs[index].tool == EditorTool.panel-vcut: vcut-toolbar := AddVCutToolBar {
                section-index: section-index;
                section: section;
            }

            if tabs[index].tool == EditorTool.select && tabs[index].select-hole: sel-hole-toolbar := AddHoleToolBar {
                section-index: section-index;
                section: section;
            }

            if tabs[index].tool == EditorTool.select && tabs[index].select-fiducial: sel-fiducial-toolbar := AddFiducialToolBar {
                section-index: section-index;
                section: section;
            }

            if tabs[index].tool == EditorTool.select && tabs[index].select-vcut: sel-vcut-toolbar := AddVCutToolBar {
                section-index: section-index;
                section: section;
            }
        }

        view-buttons-l := VerticalLayout {
            x: parent.width - self.preferred-width - 7px;
            y: toolbutton-offset-y + 7px;
            width: self.preferred-width;

            zoom-fit-btn := SceneButton {
                icon: @image-url("../../../../../img/zoom-fit.svg");
                base-color: tabs[index].background-color;
                base-text-color: tabs[index].foreground-color;

                clicked => {
                    Backend.trigger-tab(section-index, index, TabAction.zoom-fit);
                }
            }

            zoom-in-btn := SceneButton {
                icon: @image-url("../../../../bootstrap-icons/icons/zoom-in.svg");
                base-color: tabs[index].background-color;
                base-text-color: tabs[index].foreground-color;

                clicked => {
                    Backend.trigger-tab(section-index, index, TabAction.zoom-in);
                }
            }

            zoom-out-btn := SceneButton {
                icon: @image-url("../../../../bootstrap-icons/icons/zoom-out.svg");
                base-color: tabs[index].background-color;
                base-text-color: tabs[index].foreground-color;

                clicked => {
                    Backend.trigger-tab(section-index, index, TabAction.zoom-out);
                }
            }

            show-copper-btn := SceneButton {
                icon: @image-url("../../../../../img/show-copper-layers.svg");
                tooltip: @tr("Copper Layers");
                base-color: tabs[index].background-color;
                base-text-color: tabs[index].foreground-color;
                style: checkbox;
                checked: tabs[index].show-copper;

                clicked => {
                    tabs[index].show-copper = !self.checked;
                }
            }

            show-tabs-btn := SceneButton {
                icon: @image-url("../../../../../img/show-tab-markers.svg");
                tooltip: @tr("Tab Markers");
                base-color: tabs[index].background-color;
                base-text-color: tabs[index].foreground-color;
                style: checkbox;
                checked: tabs[index].show-tabs;

                clicked => {
                    tabs[index].show-tabs = !self.checked;
                }
            }

            // Placeholder icon (Font Awesome "square").
            show-board-outlines-btn := SceneButton {
                icon: @image-url("../../../../font-awesome/svgs/regular/square.svg");
                tooltip: @tr("Board Outlines");
                base-color: tabs[index].background-color;
                base-text-color: tabs[index].foreground-color;
                style: checkbox;
                checked: tabs[index].show-board-outlines;

                clicked => {
                    tabs[index].show-board-outlines = !self.checked;
                }
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                Data.set-current-tab(section-index, index);
                if !root.has-focus {
                    root.focus();
                }
            }
            Backend.scene-pointer-event(section-index, self.mouse-x, self.mouse-y, event, 0);
        }

        scroll-event(event) => {
            Backend.scene-scrolled(section-index, self.mouse-x, self.mouse-y, event, 0) ? accept : reject
        }
    }

    focus-gained(reason) => {
        Data.set-current-tab(section-index, index);
    }

    key-pressed(event) => {
        // If the focus is in some other widget, make the Escape key moving
        // the focus back to the graphics scene without triggering any action.
        if (event.text == Key.Escape) && (!root.has-focus) {
            root.focus();
            return accept;
        }
        reject
    }

    key-released(event) => {
        Backend.scene-key-released(section-index, event) ? accept : reject
    }
}
