import {
    LengthEdit,
    ToolBarButton,
} from "../../widgets.slint";
import {
    PanelTabData,
    WindowSectionData,
} from "../../api.slint";

// Toolbar of the Panel's Add V-Cut tool (also shown for a V-cuts-only
// selection in the Select tool): V-cuts are either horizontal or
// vertical (arbitrary angles aren't manufacturable), chosen with these two
// mutually exclusive buttons. The snap offset field is the distance kept to
// the board or panel edge a V-cut snaps to (positive = away from a board /
// inward from a panel edge, negative = toward a board).
export component AddVCutToolBar inherits HorizontalLayout {
    in property <int> section-index;
    in-out property <WindowSectionData> section;
    property <[PanelTabData]> tabs: section.panel-tabs;

    spacing: 2px;

    horizontal-btn := ToolBarButton {
        icon: @image-url("../../../../font-awesome/svgs/solid/grip-lines.svg");
        tooltip: @tr("Horizontal");
        checkable: true;
        checked: !tabs[section.current-tab-index].tool-vcut-vertical;

        clicked => {
            tabs[section.current-tab-index].tool-vcut-vertical = false;
        }
    }

    vertical-btn := ToolBarButton {
        icon: @image-url("../../../../font-awesome/svgs/solid/grip-lines-vertical.svg");
        tooltip: @tr("Vertical");
        checkable: true;
        checked: tabs[section.current-tab-index].tool-vcut-vertical;

        clicked => {
            tabs[section.current-tab-index].tool-vcut-vertical = true;
        }
    }

    snap-offset-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-vcut-snap-offset;
        icon: @image-url("../../../../font-awesome/svgs/solid/ruler-horizontal.svg");
        tooltip: @tr("Snap Offset");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-vcut-snap-offset.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-vcut-snap-offset.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-vcut-snap-offset.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-vcut-snap-offset.decrease = true;
        }
    }
}
