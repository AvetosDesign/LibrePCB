          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="cbxDefaultMouseBites">
            <property name="text">
             <string>Include Mouse Bites on Tabs</string>
            </property>
            <property name="toolTip">
             <string>Whether tabs get mouse bite holes along their cut lines by default</string>
            </property>
