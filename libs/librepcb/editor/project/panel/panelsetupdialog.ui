              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="toolTip">
             <string>Width of the frame (rail) along the left and right panel edges, for the Open routing style (0 = no frame there)</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="lblBackboneWidth">
            <property name="text">
             <string>Backbone Width:</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QDoubleSpinBox" name="spbxBackboneWidth">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="toolTip">
             <string>Width of the backbones along the midline between neighboring boards, for the Open routing style. A backbone is only created where the gap fits it plus a route on each side (0 = no backbones)</string>
            </property>
           </widget>
          </item>
