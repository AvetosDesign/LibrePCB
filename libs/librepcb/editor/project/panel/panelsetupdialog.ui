             <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="toolTip">
             <string>Minimum distance between a V-cut line and the edge of the panel (manufacturers typically require 5.0 mm to 20.0 mm)</string>
            </property>
            <property name="suffix">
             <string> mm</string>
            </property>
            <property name="decimals">
             <number>2</number>
            </property>
            <property name="minimum">
             <double>5.0</double>
            </property>
            <property name="maximum">
             <double>20.0</double>
