          <item row="0" column="0">
           <widget class="QLabel" name="lblRoutingStyle">
            <property name="text">
             <string>Routing Style:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="cbxRoutingStyle">
            <property name="toolTip">
             <string>None: boards are not routed (V-cuts only). Open: everything except the frame, the backbones and the tabs is removed. Tight: a single route around each board, interrupted by the tabs.</string>
            </property>
            <item>
             <property name="text">
              <string>None</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Open</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Tight</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="lblFrameWidthTopBottom">
            <property name="text">
             <string>Frame Width Top/Bottom:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="spbxFrameWidthTopBottom">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="toolTip">
             <string>Width of the frame (rail) along the top and bottom panel edges, for the Open routing style (0 = no frame there)</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="lblFrameWidthLeftRight">
            <property name="text">
